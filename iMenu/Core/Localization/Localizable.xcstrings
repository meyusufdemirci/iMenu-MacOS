    "error.recovery.menuBarItemReorder": {
      "comment": "Recovery suggestion for a failed menu bar item reorder",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some items can’t be rearranged. Try moving a different item, or drag it in the menu bar by holding ⌘."
