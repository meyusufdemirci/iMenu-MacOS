    "permissions.screenRecording.detail": {
      "comment": "Explanation of why iMenu needs Screen Recording permission",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets iMenu capture how your menu bar items look so it can show their icons in the second row."
          }
        }
      }
    },
    "permissions.screenRecording.footer": {
      "comment": "Reassurance about how the Screen Recording permission is used",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iMenu captures only your menu bar to mirror item icons — nothing else on your screen is recorded or stored."
          }
        }
      }
    },
    "permissions.screenRecording.section": {
