    "layout.reorderHint": {
      "comment": "Footer on the Layout page explaining that Layout edits change the real menu bar and the chevron toggles the hidden items",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag items within Visible to reorder them in your real menu bar. Moving an item to Hidden tucks it behind iMenu’s separator — use the menu bar arrow to show or hide the hidden items. Some system items can’t be moved."
          }
        }
      }
    },
    "layout.retry": {
