    "permissions.accessibility.detail": {
      "comment": "Explanation of why iMenu needs Accessibility permission",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets iMenu read and rearrange the menu bar items of other apps."
          }
        }
      }
    },
    "permissions.accessibility.footer": {
      "comment": "Reassurance about how the Accessibility permission is used",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iMenu uses this only to read your menu bar layout and to rearrange items when you ask — it never reads anything else or controls other apps."
          }
        }
      }
    },
    "permissions.accessibility.section": {
      "comment": "Header for the Accessibility section of the Permissions page",
